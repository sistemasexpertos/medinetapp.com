imonial-card"],"components":[{"type":"image","name":"Testimonial Image","resizable":{"ratioDefault":1},"classes":["testimonial-image"],"attributes":{"src":"https://cdn.grapesjs.com/workspaces/cmhxptjkg1vmqhtj9atld96o3/assets/f8d148de-414e-42b5-a30e-45716ecc4b09__recurso-4300x.png","alt":"Clínica A","loading":"lazy","id":"iy8i4v"}},{"name":"Testimonial Content","classes":["testimonial-content"],"components":[{"tagName":"p","type":"text","name":"Testimonial Text","classes":["testimonial-text"],"attributes":{"id":"ieuojj"},"components":[{"type":"textnode","content":"“A través de la plataforma de Hospital de MEDINET hemos podido gestionar las camas de la casa de acogida de tal forma de facilitar nuestro trabajo y también mejorar y hacer de forma más sencilla el contacto con los pacientes que nos visitan en nuestras dependencias”."}]},{"name":"Testimonial Author","classes":["testimonial-author"],"components":[{"type":"image","name":"Author Photo","resizable":{"ratioDefault":1},"classes":["author-photo"],"attributes":{"src":"https://cdn.grapesjs.com/workspaces/cmhxptjkg1vmqhtj9atld96o3/assets/1643ccf5-f8ff-4675-99b1-293db79aca1a__recurso-6300x.png","alt":"Autor","loading":"lazy","id":"i65n4q"}},{"name":"Author Info","components":[{"tagName":"p","type":"text","name":"Author Name","classes":["author-name"],"attributes":{"id":"i61dlg"},"components":[{"type":"textnode","content":"Joaquín Mardones"}]},{"tagName":"p","type":"text","name":"Author Role","classes":["author-role"],"attributes":{"id":"imfwb3"},"components":[{"type":"textnode","content":"Jefe de proyectos - Fundación Renal Mater"}]}]}]}]}]},{"name":"Testimonial Card","classes":["testimonial-card"],"attributes":{"id":"itxph4"},"components":[{"type":"image","name":"Testimonial Image","resizable":{"ratioDefault":1},"classes":["testimonial-image"],"attributes":{"src":"https://cdn.grapesjs.com/workspaces/cmhxptjkg1vmqhtj9atld96o3/assets/b2945dd9-9363-437f-a1aa-e0e344bfa3c8__2024-01-04.png","alt":"Clínica B","loading":"lazy","id":"iireml"}},{"name":"Testimonial Content","classes":["testimonial-content"],"components":[{"tagName":"p","type":"text","name":"Testimonial Text","classes":["testimonial-text"],"attributes":{"id":"ict348"},"components":[{"type":"textnode","content":"“la plataforma nos permite hacer todo más rápido no tienes que estar preguntándole a cada persona en que se encuentra si no que tener un sistema único en donde yo pueda centralizar el avance y la gestión de cada una de las tareas clínicas”."}]},{"name":"Testimonial Author","classes":["testimonial-author"],"components":[{"type":"image","name":"Author Photo","resizable":{"ratioDefault":1},"classes":["author-photo"],"attributes":{"src":"https://cdn.grapesjs.com/workspaces/cmhxptjkg1vmqhtj9atld96o3/assets/8d52a891-17b3-43fb-ad12-b8cfc9186fbe__recurso-5300x.png","alt":"Autor","loading":"lazy","id":"ipe51k"}},{"name":"Author Info","components":[{"tagName":"p","type":"text","name":"Author Name","classes":["author-name"],"attributes":{"id":"i4j0lt"},"components":[{"type":"textnode","content":"Manuel Prieto"}]},{"tagName":"p","type":"text","name":"Author Role","classes":["author-role"],"attributes":{"id":"i1u8eh"},"components":[{"type":"textnode","content":"Gerente comercial - Clínica Lo Arcaya"}]}]}]}]}]},{"name":"Testimonial Card","classes":["testimonial-card"],"components":[{"type":"image","name":"Testimonial Image","resizable":{"ratioDefault":1},"classes":["testimonial-image"],"attributes":{"src":"https://cdn.grapesjs.com/workspaces/cmhxptjkg1vmqhtj9atld96o3/assets/79b0b413-838e-4cfb-970e-0a105523fc83__sanatorio-maritimo.png","alt":"Hospital C","loading":"lazy","id":"irutwy"}},{"name":"Testimonial Content","classes":["testimonial-content"],"components":[{"tagName":"p","type":"text","name":"Testimonial Text","classes":["testimonial-text"],"attributes":{"id":"iukwrd"},"components":[{"type":"textnode","content":"“Medinet nos ha permitido organizar la gestión hospitalaria con una plataforma amigable para todos los profesionales de salud. Hoy tenemos una visión clara de nuestros usuarios, sus patologías y condiciones, además de una administración más eficiente de camas, medicamentos y bodegas. Gracias a esto logramos un manejo clínico y administrativo integrado, optimizando recursos y mejorando la atención.”"}]},{"name":"Testimonial Author","classes":["testimonial-author"],"components":[{"type":"image","name":"Author Photo","resizable":{"ratioDefault":1},"classes":["author-photo"],"attributes":{"src":"https://cdn.grapesjs.com/workspaces/cmhxptjkg1vmqhtj9atld96o3/assets/a89e64f1-5c5b-4ea5-a8ac-a9b4be7cf0af__recurso-7300x.png","alt":"Autor","loading":"lazy","id":"ihtqyg"}},{"name":"Author Info","components":[{"tagName":"p","type":"text","name":"Author Name","classes":["author-name"],"attributes":{"id":"itwb67"},"components":[{"type":"textnode","content":"Facundo Luna"}]},{"tagName":"p","type":"text","name":"Author Role","classes":["author-role"],"attributes":{"id":"ivyabx"},"components":[{"type":"textnode","content":"Director médico - Sanatorio Marítimo San Juan de Dios"}]}]}]}]}]}]}]}]},{"tagName":"section","name":"FAQ Section","classes":["faq-section"],"components":[{"name":"FAQ Container","classes":["faq-container"],"components":[{"tagName":"h2","type":"heading","name":"FAQ Title","classes":["gjs-t-h2","faq-title"],"attributes":{"id":"ia82w9"},"components":[{"type":"textnode","content":"Preguntas frecuentes"}]},{"name":"FAQ List","classes":["faq-list"],"components":[{"name":"FAQ Item","classes":["faq-item"],"components":[{"type":"button","name":"FAQ Header","classes":["faq-header"],"attributes":{"type":"button","aria-expanded":"false"},"components":[{"type":"contentEditable","components":[{"tagName":"span","type":"text","name":"FAQ Question","classes":["faq-question"],"components":[{"type":"textnode","content":"¿Cuánto tarda la implementación?"}]},{"type":"image","name":"FAQ Toggle Icon","resizable":{"ratioDefault":1},"classes":["faq-toggle-icon"],"attributes":{"src":"https://api.iconify.design/lucide-chevron-down.svg?color=%230D47A1","alt":"toggle"}}]}]},{"name":"FAQ Content","classes":["faq-content"],"components":[{"tagName":"p","type":"text","name":"FAQ Answer","classes":["faq-answer"],"components":[{"type":"textnode","content":"Dependiendo del alcance, la puesta en marcha se realiza entre 4 y 12 semanas con acompañamiento funcional, técnico y migración de datos."}]}]}]},{"name":"FAQ Item","classes":["faq-item"],"components":[{"type":"button","name":"FAQ Header","classes":["faq-header"],"attributes":{"type":"button","aria-expanded":"false"},"components":[{"type":"contentEditable","components":[{"tagName":"span","type":"text","name":"FAQ Question","classes":["faq-question"],"components":[{"type":"textnode","content":"¿Se integra con mi sistema contable y de pagos?"}]},{"type":"image","name":"FAQ Toggle Icon","resizable":{"ratioDefault":1},"classes":["faq-toggle-icon"],"attributes":{"src":"https://api.iconify.design/lucide-chevron-down.svg?color=%230D47A1","alt":"toggle"}}]}]},{"name":"FAQ Content","classes":["faq-content"],"components":[{"tagName":"p","type":"text","name":"FAQ Answer","classes":["faq-answer"],"components":[{"type":"textnode","content":"Sí. Contamos con integraciones listas para Defontana, Softland, Transbank, MercadoPago, Imed, Receta Electrónica, Twilio, Zoom, entre otras."}]}]}]},{"name":"FAQ Item","classes":["faq-item"],"components":[{"type":"button","name":"FAQ Header","classes":["faq-header"],"attributes":{"type":"button","aria-expanded":"false"},"components":[{"type":"contentEditable","components":[{"tagName":"span","type":"text","name":"FAQ Question","classes":["faq-question"],"components":[{"type":"textnode","content":"¿Cómo resguardan la seguridad de la información?"}]},{"type":"image","name":"FAQ Toggle Icon","resizable":{"ratioDefault":1},"classes":["faq-toggle-icon"],"attributes":{"src":"https://api.iconify.design/lucide-chevron-down.svg?color=%230D47A1","alt":"toggle"}}]}]},{"name":"FAQ Content","classes":["faq-content"],"components":[{"tagName":"p","type":"text","name":"FAQ Answer","classes":["faq-answer"],"components":[{"type":"textnode","content":"Aplicamos estándares ISO 27001, cifrado en tránsito y reposo, controles por perfil y auditoría continua."}]}]}]}]}]}]},{"tagName":"section","name":"Final CTA Section","classes":["final-cta-section"],"components":[{"name":"Final CTA Container","classes":["final-cta-container"],"attributes":{"id":"ik8s92"},"components":[{"tagName":"h2","type":"heading","name":"Final CTA Title","classes":["gjs-t-h2","final-cta-title"],"attributes":{"id":"i26e0b"},"components":[{"type":"textnode","content":"¿Listo para transformar la gestión de tu clínica?"}]},{"name":"Final CTA Actions","classes":["final-cta-actions"],"components":[{"type":"link","name":"CTA Button","classes":["gjs-t-button","cta-button"],"attributes":{"href":"#","id":"ipd744"},"components":[{"type":"textnode","content":"\n            Solicitar demo gratuita\n          "}]},{"type":"link","name":"CTA Button","classes":["cta-button"],"attributes":{"href":"#","id":"iiy80d"},"components":[{"type":"textnode","content":"Contactar a un ejecutivo"}]}]}]}]}]},{"tagName":"footer","name":"Footer","classes":["footer"]},{"type":"script","name":"Interaction Script","attributes":{"id":"i3bz2s"},"components":[{"type":"textnode","content":"\n  (function(){\n    const track = document.getElementById('modulesTrack');\n    const slides = Array.from(track.children);\n    const prevBtn = document.getElementById('modulesPrev');\n    const nextBtn = document.getElementById('modulesNext');\n    const iconRow = document.getElementById('modulesIcons');\n    const iconButtons = Array.from(iconRow.querySelectorAll('[data-index]'));\n    let current = 0;\n    let isAnimating = false;\n\n    function markActiveSlide() {\n      slides.forEach((s, i) => {\n        if (i === current) s.classList.add('is-active');\n        else s.classList.remove('is-active');\n      });\n    }\n\n    function updateSlider(index){\n      if(isAnimating) return;\n      isAnimating = true;\n      current = Math.max(0, Math.min(index, slides.length - 1));\n      const offset = -current * track.clientWidth;\n      track.style.transform = `translateX(${offset}px)`;\n      updateIcons();\n      markActiveSlide();\n      setTimeout(()=>{ isAnimating = false; }, 400);\n    }\n\n    function setIconColor(img, toWhite){\n      try {\n        const u = new URL(img.src);\n        u.searchParams.set('color', toWhite ? '#FFFFFF' : '#0D47A1');\n        img.src = u.toString();\n      } catch (e) {\n        const white = 'color=%23FFFFFF';\n        const blue = 'color=%230D47A1';\n        if (/color=%23/i.test(img.src)) {\n          img.src = img.src.replace(/color=%23[0-9A-Fa-f]{6}/, toWhite ? white : blue);\n        }\n      }\n    }\n\n    function updateIcons(){\n      iconButtons.forEach((btn, i) => {\n        const img = btn.querySelector('img');\n        const isActive = i === current;\n        btn.classList.toggle('is-active', isActive);\n        setIconColor(img, isActive);\n        if(isActive){\n          img.classList.remove('opacity-80');\n        } else {\n          img.classList.add('opacity-80');\n        }\n      });\n    }\n\n    prevBtn.addEventListener('click', () => updateSlider(current - 1));\n    nextBtn.addEventListener('click', () => updateSlider(current + 1));\n    iconButtons.forEach(btn => {\n      btn.addEventListener('click', () => {\n        const idx = parseInt(btn.getAttribute('data-index'), 10);\n        updateSlider(idx);\n      });\n    });\n\n    let startX = 0, deltaX = 0, isTouch = false;\n    track.addEventListener('touchstart', (e) => {\n      isTouch = true;\n      startX = e.touches[0].clientX;\n      deltaX = 0;\n    }, {passive: true});\n    track.addEventListener('touchmove', (e) => {\n      if(!isTouch) return;\n      deltaX = e.touches[0].clientX - startX;\n    }, {passive: true});\n    track.addEventListener('touchend', () => {\n      isTouch = false;\n      if(Math.abs(deltaX) > 50){\n        if(deltaX < 0) updateSlider(current + 1);\n        else updateSlider(current - 1);\n      }\n      deltaX = 0;\n    });\n\n    window.addEventListener('resize', () => updateSlider(current));\n    updateSlider(0);\n\n    const faqItems = document.querySelectorAll('[data-gjs-name=\"FAQ Item\"]');\n    faqItems.forEach(item => {\n      const header = item.querySelector('[data-gjs-name=\"FAQ Header\"]');\n      const content = item.querySelector('[data-gjs-name=\"FAQ Content\"]');\n      const icon = item.querySelector('[data-gjs-name=\"FAQ Toggle Icon\"]');\n      if(!header || !content || !icon) return;\n      content.style.maxHeight = '0px';\n      content.style.transition = 'max-height 250ms ease';\n      header.addEventListener('click', () => {\n        const expanded = header.getAttribute('aria-expanded') === 'true';\n        header.setAttribute('aria-expanded', (!expanded).toString());\n        if(expanded){\n          content.style.maxHeight = '0px';\n          icon.style.transform = 'rotate(0deg)';\n        } else {\n          content.style.maxHeight = content.scrollHeight + 'px';\n          icon.style.transform = 'rotate(180deg)';\n        }\n      });\n    });\n  })();\n"}]}],"doctype":"<!DOCTYPE html>","head":{"type":"head","name":"Head","components":[{"tagName":"meta","name":"Meta Charset","void":true,"attributes":{"charset":"utf-8"}},{"tagName":"meta","name":"Meta Viewport","void":true,"attributes":{"name":"viewport","content":"width=device-width, initial-scale=1"}},{"tagName":"title","type":"text","name":"Document Title","components":[{"type":"textnode","content":"Medinet — Plataforma clínica HIS escalable"}]},{"tagName":"link","name":"Google Fonts","void":true,"attributes":{"href":"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Public+Sans:wght@400;600;800&display=swap","rel":"stylesheet"}}]},"docEl":{"tagName":"html","attributes":{"lang":"es"}}},"id":"rgpRKnFtwj8My4LD","minHeight":"500px"}],"id":"iz0sat2yd0kpktfZ"}],"symbols":[{"type":"image","resizable":{"ratioDefault":1},"classes":["module-icon"],"attributes":{"src":"https://api.iconify.design/lucide-syringe.svg?color=%230D47A1","alt":"Quirúrgica","id":"i4uxw5-2"},"__symbols":["i4uxw5"]}],"custom":{"projectType":"web","id":"","globalPageSettings":{"fonts":{"Roboto":{"family":"Roboto","familyLabel":"Roboto","menuVariant":{"family":"menuFont-Roboto","variant":"regular","source":"https://fonts.gstatic.com/s/roboto/v49/KFOMCnqEu92Fr1ME7kSn66aGLdTylUAMQXC89YmC2DPNWubEbVmSiAo.woff2"},"variants":{"regular":{"family":"Roboto","variant":"regular","source":"https://fonts.gstatic.com/s/roboto/v49/KFOmCnqEu92Fr1Me4GZLCzYlKw.woff2","descriptors":{"weight":"100 900"}},"italic":{"family":"Roboto","variant":"italic","source":"https://fonts.gstatic.com/s/roboto/v49/KFOkCnqEu92Fr1Mu52xKKTM1K9nz.woff2","descriptors":{"style":"italic","weight":"100 900"}}}}}}}}